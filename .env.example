# Copy to .env and fill in values. Required vars are marked (required).
# Schema source of truth: src/config/env.ts

NODE_ENV=development
PORT=3000

# PostgreSQL (required)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=skillbridge_dev
DATABASE_SYNC=false
DATABASE_LOGGING=false
DATABASE_SSL=false
# DATABASE_SSL_CA=   # optional — PEM cert when DATABASE_SSL=true

# Redis (optional — advanced assessment submit queue runs inline when unset)
# REDIS_URL=redis://localhost:6379

# JWT (required — secrets must be at least 32 characters each)
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-too-to-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=7d

# Email verification OTP
VERIFICATION_OTP_EXPIRES_IN=15m
VERIFICATION_RESEND_LIMIT_PER_HOUR=3

# Password reset OTP
PASSWORD_RESET_OTP_EXPIRES_IN=15m
PASSWORD_RESET_RATE_LIMIT_PER_HOUR=5

# Email — Resend (required)
RESEND_API_KEY=re_your_resend_api_key
RESEND_MAIL_FROM=noreply@yourdomain.com
# Email logos use bundled inline logo-with-text-white.svg (teal header in templates).
# Optional CDN overrides — checked only when bundled asset is unavailable.
# EMAIL_LOGO_WHITE_URL takes precedence over EMAIL_LOGO_URL when both are set.
# EMAIL_LOGO_WHITE_URL=https://your-cdn.example.com/logo-with-text-white.png
# EMAIL_LOGO_URL=https://your-cdn.example.com/logo-with-text-white.png
SUPPORT_EMAIL=support@skillbridge.com

# Google OAuth (required)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
GOOGLE_DEFAULT_COUNTRY=Unknown

# App URLs
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
# AUTH_COOKIE_SAMESITE=strict   # strict | lax | none (use none for cross-site cookies in prod)
SWAGGER_ENABLED=true

# Seed admin (used by database seeders — override in every deployment)
SEED_ADMIN_EMAIL=<your-admin-email>
SEED_ADMIN_PASSWORD=<your-admin-password>
SEED_ADMIN_FULL_NAME=<your-admin-full-name>

# Content team — comma-separated emails notified when a question bank is exhausted (503 BANK_EXHAUSTED)
# Optional; alert is a no-op when unset
CONTENT_TEAM_BANK_ALERT_EMAILS=content@example.com

# MinIO / S3 (optional — avatar uploads disabled when unset)
AWS_REGION=us-east-1
AWS_S3_BUCKET=skillbridge-uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_PUBLIC_URL=http://127.0.0.1:9000/skillbridge-uploads

# AI providers (optional — at least one needed for assessment scoring / reports)
# Priority: Anthropic → Gemini → OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash

# Offers (optional — defaults to built-in monthly cap when unset)
# OFFERS_MONTHLY_CAP=50

# Dev / seeding only (optional)
# QUESTION_BANK_SEED_FILE=path/to/custom-question-bank.json
