{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": "<rootDir>/tsconfig.json" }]
  },
  "setupFiles": ["<rootDir>/jest-e2e.setup.ts"],
  "moduleNameMapper": {
    "^@t3-oss/env-core$": "<rootDir>/mocks/env-core.ts"
  }
}
